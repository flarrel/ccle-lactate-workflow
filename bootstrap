#!/bin/sh
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
mkdir -p "$repo/../runtime"
runtime=$(CDPATH= cd -- "$repo/../runtime" && pwd)
export TMPDIR="$runtime/tmp"
export XDG_CACHE_HOME="$runtime/cache"
export PYTHONDONTWRITEBYTECODE=1
mkdir -p "$TMPDIR" "$XDG_CACHE_HOME"
python3 "$repo/src/download.py" "$runtime"
python3 -m venv "$runtime/venv"
"$runtime/venv/bin/python" -m pip --disable-pip-version-check --no-cache-dir install \
  --only-binary=:all: -r "$repo/requirements.txt"
mkdir -p "$runtime/llama"
tar -xzf "$runtime/llama.tar.gz" -C "$runtime/llama" --strip-components 1
